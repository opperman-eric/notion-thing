OPENAI_API_KEY=
NOTION_TOKEN=
# ID from the URL of your Projects database (not a project page).
NOTION_PROJECTS_DATABASE_ID=
# Choose a long password for this private app (at least 12 characters).
APP_PASSWORD=
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this value unchanged across deployments to preserve 30-day sign-ins.
SESSION_SECRET=
PORT=3000
TIME_ZONE=Pacific/Auckland
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
EXTRACTION_MODEL=gpt-4o-mini
# Names must match your Notion columns and inline database title.
NOTION_TIME_DATABASE_NAME=Time Spent
NOTION_TASK_PROPERTY=Task Name
NOTION_DATE_PROPERTY=Date
NOTION_MINUTES_PROPERTY=Minutes
# Optional: for projects with multiple data sources, choose the Projects source ID.
NOTION_PROJECTS_DATA_SOURCE_ID=
# Optional JSON mapping for linked views or nested tables:
# NOTION_TIME_DATABASE_MAP={"project-page-id":"time-database-id"}
